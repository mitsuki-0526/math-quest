{
  "name": "math-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "katex": "^0.18.7",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.2",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
